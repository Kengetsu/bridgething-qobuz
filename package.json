{
  "name": "qobuz-carthing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:bridgething": "tsc -b && vite build --mode bridgething && vite build -c vite.settings.config.ts",
    "build:device": "tsc -b && vite build --mode carthing && node scripts/transpile-chrome69.mjs",
    "package:bridgething": "node scripts/package-bridgething.mjs",
    "release:bridgething": "npm run build:bridgething && npm run package:bridgething",
    "bridge": "bun server/index.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@bridgething/client": "^0.4.0",
    "@vitejs/plugin-react": "latest",
    "dbus-next": "^0.10.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
